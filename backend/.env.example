# App
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="TaxFlow Platform API"
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-this-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database — Neon (managed Postgres) in production; local Postgres for dev.
# Two connection strings matter for Neon specifically: a *pooled* one (use
# it here, for DATABASE_URL — this is what the running app should use) and
# a *direct* one (used only for running `alembic upgrade head` by hand —
# see docs/deployment.md for why migrations aren't run automatically).
POSTGRES_USER=taxflow
POSTGRES_PASSWORD=taxflow_dev_password
POSTGRES_DB=taxflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://taxflow:taxflow_dev_password@localhost:5432/taxflow

# CORS — set to the real Cloudflare Workers frontend URL in production.
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Object storage — Cloudflare R2 (S3-compatible; see app/services/storage_service.py).
# S3_ENDPOINT_URL should be https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY come from an R2 API token
# (Cloudflare dashboard -> R2 -> Manage API Tokens), not an AWS IAM user.
# S3_REGION should stay "auto" — that's R2's own convention, not a real AWS
# region name.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=taxflow-documents
S3_REGION=auto

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# WhatsApp Business API (Meta Cloud API) — leave blank for local dev; inbound
# webhook shape-parsing and phone-to-client matching still work with these
# unset, but media download and outbound replies are no-ops. See
# app/services/notification_channels.py.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v21.0
# App Secret from Meta's App Dashboard — used to verify X-Hub-Signature-256
# on inbound webhook POSTs. Required before exposing the webhook publicly.
WHATSAPP_APP_SECRET=

# Email — Resend (https://resend.com). Leave RESEND_API_KEY blank for local
# dev; EmailSender falls back to logging what it would have sent.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@taxflow.app

# SMS — Twilio. Leave blank for local dev; SMSSender falls back to logging
# what it would have sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OCR — "tesseract" (local, pytesseract; the only one actually implemented)
# or "google_document_ai" (not yet implemented; falls back to tesseract).
OCR_PROVIDER=tesseract
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=
# Documents above this size are skipped for auto-OCR (logged, not crashed)
# rather than run on the same small free-tier instance that also serves API
# requests — see app/worker/tasks.py.
OCR_MAX_FILE_SIZE_MB=5
# Explicit ceiling passed to pdf2image.convert_from_bytes — deliberately
# lower than its default, to bound memory/CPU on a small instance.
OCR_RENDER_DPI=150

# Razorpay — payments, for both the firm's own TaxFlow subscription billing
# (app/services/billing_service.py) and the firm's client invoicing
# (app/services/invoice_service.py). RAZORPAY_KEY_ID/RAZORPAY_KEY_SECRET
# come from Settings -> API Keys in the Razorpay dashboard (test-mode keys
# start with rzp_test_). RAZORPAY_WEBHOOK_SECRET is a value *you* choose
# when you add the webhook URL under Settings -> Webhooks (not one Razorpay
# generates for you) — set it to the same value in both places. Leave all
# three blank for local dev; anything that would create a payment or verify
# a webhook raises a clear error rather than silently no-op'ing (unlike the
# notification channels above — see app/services/razorpay_service.py for
# why that distinction matters here).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry — error monitoring. Leave blank for local dev; no-op if unset.
SENTRY_DSN=

# Shared secret required in the X-Internal-Task-Secret header on
# GET /internal/tasks/heartbeat (see app/api/v1/endpoints/internal.py).
# This endpoint runs the scheduled jobs that used to be a Celery beat
# schedule, so it must never be publicly triggerable — generate a long
# random string for this in every real environment (e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`). There is
# no safe default; requests are rejected if this is unset.
INTERNAL_TASK_SECRET=
